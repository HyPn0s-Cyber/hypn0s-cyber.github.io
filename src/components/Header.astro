---
// src/components/Header.astro
const navItems = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Newsletter", href: "/newsletter/" },
  { label: "About", href: "/about/" },
];
---
<header style="display:flex; justify-content:space-between; align-items:center; padding:1.5rem; border-bottom:1px solid var(--border);">
  <a href="/" style="font-family:var(--font-display); font-size:1.3rem; color:var(--ink);">
    <span class="glyph">◉</span> Hypn0s<span style="color:var(--ink-dim);">//</span>Cyber
  </a>
  <nav style="display:flex; gap:1.5rem; font-family:var(--font-mono); font-size:0.85rem;">
    {navItems.map((item) => (
      <a href={item.href} style="color:var(--ink-dim);">{item.label}</a>
    ))}
  </nav>
</header>