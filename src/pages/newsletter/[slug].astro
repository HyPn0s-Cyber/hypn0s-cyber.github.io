---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('newsletter');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{post.data.title} — Hypn0s Cyber</title>
</head>
<body>
  <Header />
  <main class="container" style="padding-top:3rem; padding-bottom:5rem;">
    {post.data.cover && (
      <img src={post.data.cover} alt="" style="width:100%; border-radius:6px; margin-bottom:2rem; border:1px solid var(--border);" />
    )}
    <p class="meta">
      {post.data.date.toLocaleDateString('en-CA')}
      {post.data.readingTime && ` · ${post.data.readingTime} min read`}
    </p>
    <h1>{post.data.title}</h1>
    <article>
      <Content />
    </article>
  </main>
  <Footer />
</body>
</html>